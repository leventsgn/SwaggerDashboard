@page "/login"
@layout Layout.MainLayout

@* Static SSR: signing in issues a cookie, which has to happen on a real HTTP round trip. *@

<PageTitle>Giriş - Swagger Dashboard</PageTitle>

<div class="sd-narrow">
    <h1>Giriş</h1>

    @if (Error is not null)
    {
        <div class="alert alert-danger py-2">Kullanıcı adı veya parola hatalı.</div>
    }

    <form method="post" action="/account/login" class="sd-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <label class="form-label" for="userName">Kullanıcı adı</label>
        <input class="form-control" id="userName" name="userName" autocomplete="username" required />

        <label class="form-label mt-2" for="password">Parola</label>
        <input class="form-control" id="password" name="password" type="password"
               autocomplete="current-password" required />

        <button class="btn btn-primary mt-3" type="submit">Giriş yap</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
