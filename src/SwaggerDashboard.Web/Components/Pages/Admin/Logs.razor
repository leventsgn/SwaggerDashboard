@page "/admin/logs"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]
@using SwaggerDashboard.Infrastructure.Identity
@inject IRequestLogService LogService
@inject IApiDefinitionService DefinitionService
@inject IUserService UserService

<PageTitle>İstek logları - Swagger Dashboard</PageTitle>

<div class="sd-page sd-page-wide">
    <div class="sd-page-head">
        <h1>İstek logları</h1>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" value="@_apiFilter" @onchange="OnFilterChanged">
                <option value="">Tüm API'ler</option>
                @foreach (var definition in _definitions)
                {
                    <option value="@definition.Id">@definition.Name</option>
                }
            </select>
            <select class="form-select form-select-sm" value="@_pageSize" @onchange="OnPageSizeChanged">
                @foreach (var size in PageSizes)
                {
                    <option value="@size">@size satır</option>
                }
            </select>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync">Yenile</button>
        </div>
    </div>

    @if (_page is null)
    {
        <p class="text-secondary">Yükleniyor...</p>
    }
    else if (_page.Rows.Count == 0)
    {
        <p class="text-secondary">@(_page.TotalCount == 0 ? "Kayıt yok." : "Bu sayfada kayıt yok.")</p>
    }
    else
    {
        <p class="text-secondary small">
            @(_page.Skip + 1)–@(_page.Skip + _page.Rows.Count) / toplam @_page.TotalCount kayıt
        </p>

        <div class="sd-panel sd-panel-table">
        <table class="table table-sm sd-table">
            <thead>
            <tr>
                <th>Zaman</th>
                <th>Kullanıcı</th>
                <th>Method</th>
                <th>URL</th>
                <th>Status</th>
                <th>Süre</th>
                <th>IP</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var log in _page.Rows)
            {
                <tr class="@(log.IsSuccess ? null : "table-warning")">
                    <td>@log.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@UserLabel(log.UserId)</td>
                    <td>@log.HttpMethod</td>
                    <td class="sd-break">@log.RequestUrl</td>
                    <td>@(log.ResponseStatusCode == 0 ? "hata" : log.ResponseStatusCode.ToString())</td>
                    <td>@log.DurationMilliseconds ms</td>
                    <td>@log.ClientIp</td>
                    <td>
                        <button class="btn btn-sm btn-link p-0"
                                @onclick="() => _expanded = _expanded == log.Id ? null : log.Id">
                            @(_expanded == log.Id ? "Gizle" : "Detay")
                        </button>
                    </td>
                </tr>

                @if (_expanded == log.Id)
                {
                    <tr>
                        <td colspan="8">
                            <div class="sd-log-detail">
                                @if (log.ErrorMessage is not null)
                                {
                                    <p class="text-danger">@log.ErrorMessage</p>
                                }
                                <h5>Request headers</h5>
                                <pre class="sd-pre">@log.RequestHeadersJson</pre>
                                <h5>Response headers</h5>
                                <pre class="sd-pre">@log.ResponseHeadersJson</pre>

                                @if (log.RequestBody is not null)
                                {
                                    <h5>Request body @(log.RequestBodyTruncated ? "(kesildi)" : null)</h5>
                                    <pre class="sd-pre">@log.RequestBody</pre>
                                }

                                @if (log.ResponseBody is not null)
                                {
                                    <h5>Response body @(log.ResponseBodyTruncated ? "(kesildi)" : null)</h5>
                                    <pre class="sd-pre">@log.ResponseBody</pre>
                                }

                                @if (log.RequestBody is null && log.ResponseBody is null)
                                {
                                    <p class="text-secondary small">
                                        Gövde loglama kapalı. Açmak için
                                        <code>SwaggerDashboard:Logging:PersistBodies</code> ayarını kullanın.
                                    </p>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
        </div>

        <div class="sd-log-pager">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_page.Skip == 0)"
                    @onclick="PreviousPageAsync">
                Önceki
            </button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(!_page.HasMore)"
                    @onclick="NextPageAsync">
                Sonraki
            </button>
        </div>
    }
</div>

@code {
    private static readonly int[] PageSizes = [50, 100, 200, 500];

    private LogPage? _page;
    private IReadOnlyList<ApiDefinition> _definitions = [];

    /// <summary>User id to display name, so the table names people rather than ids.</summary>
    private Dictionary<string, string> _userNames = new(StringComparer.Ordinal);

    private string _apiFilter = string.Empty;
    private int _pageSize = 100;
    private int _skip;
    private long? _expanded;

    protected override async Task OnInitializedAsync()
    {
        _definitions = await DefinitionService.ListAsync(includeInactive: true);

        _userNames = (await UserService.ListAsync())
            .ToDictionary(
                u => u.Id.ToString(),
                u => string.IsNullOrWhiteSpace(u.DisplayName) ? u.UserName : $"{u.DisplayName} ({u.UserName})",
                StringComparer.Ordinal);

        await ReloadAsync();
    }

    private async Task OnFilterChanged(ChangeEventArgs args)
    {
        _apiFilter = args.Value?.ToString() ?? string.Empty;
        _skip = 0;
        await ReloadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        _pageSize = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : 100;
        _skip = 0;
        await ReloadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _skip = Math.Max(0, _skip - _pageSize);
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        _skip += _pageSize;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        int? apiId = int.TryParse(_apiFilter, out var parsed) ? parsed : null;
        _page = await LogService.GetPageAsync(apiId, _skip, _pageSize);

        // Rows can be purged between two visits, which would otherwise leave the screen on a
        // page past the end of the list with no way back except the filter.
        if (_page.Rows.Count == 0 && _skip > 0)
        {
            _skip = 0;
            _page = await LogService.GetPageAsync(apiId, 0, _pageSize);
        }

        _expanded = null;
    }

    /// <summary>
    /// The name behind a logged user id. Ids of deleted accounts have no name left, so they
    /// are shown as they are rather than as a blank cell.
    /// </summary>
    private string UserLabel(string? userId) =>
        userId is null
            ? "-"
            : _userNames.TryGetValue(userId, out var name) ? name : userId;
}
