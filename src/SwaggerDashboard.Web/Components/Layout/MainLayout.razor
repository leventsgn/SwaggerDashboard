@inherits LayoutComponentBase

<div class="sd-shell">
    <header class="sd-topbar">
        <a class="sd-brand" href="/apis">
            <span class="sd-brand-mark">SD</span>
            <span class="sd-brand-text">Swagger Dashboard</span>
        </a>

    @* NavLink rather than a plain anchor so the current section is marked; with
       four destinations and no page chrome there was nothing else saying where
       you were. Match=All on /apis keeps it from lighting up on every dashboard
       route, which the catch-all would otherwise make it do. *@
        <nav class="sd-topnav">
            <NavLink href="/apis" Match="NavLinkMatch.All">API'ler</NavLink>
            <AuthorizeView Roles="@Roles.Admin">
                <NavLink href="/admin/apis">Yönetim</NavLink>
                <NavLink href="/admin/logs">Loglar</NavLink>
                <NavLink href="/admin/users">Kullanıcılar</NavLink>
            </AuthorizeView>
        </nav>

        <div class="sd-topbar-right">
            <ThemeToggle />
            <AuthorizeView>
                <Authorized>
                    <span class="sd-user" title="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value">
                        @context.User.Identity?.Name
                    </span>
                    <form method="post" action="/account/logout" class="d-inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Çıkış</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-sm btn-primary" href="/login">Giriş</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="sd-main">
        @Body
    </main>
</div>
